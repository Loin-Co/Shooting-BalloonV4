; ============================================================================
; states.asm - Menu, Intro, and Game Over Rendering Procedures
; Location: Src/States/
; ============================================================================

.386
.model flat, stdcall
option casemap:none

include Src\Include\common.inc
include Src\Include\protos.inc

; ============================= EXTERNAL DATA ================================
EXTERN hStdOut:DWORD
EXTERN nextState:DWORD

; ============================= PUBLIC EXPORTS ===============================
PUBLIC RenderSplash
PUBLIC RenderMenu
PUBLIC RenderGameOver
PUBLIC menuSelection

; ============================= DATA SECTION =================================
.data
    ; Splash screen - Derry Mainframe Terminal (CENTERED)
    splashBorder        db 218, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196
                        db 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196
                        db 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196
                        db 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 191, 0
    splashBorderSide    db 179, 0
    splashBorderBottom  db 192, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196
                        db 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196
                        db 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196
                        db 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 196, 217, 0
    
    splashHeader        db ">_  DERRY MAINFRAME - v1958", 0
    splashSystem        db "[ SYSTEM ]", 0
    splashWelcome       db "W E L C O M E   T O   D E R R Y   2 0 2 5", 0
    splashProtocol      db "[  BALLOON  SHOOTER  PROTOCOL  INITIATED  ]", 0
    
    splashMsg1          db "> Loading Memory Modules... ", 0
    splashMsg1OK        db "OK", 0
    splashMsg2          db "> Checking Fear Sensors...  ", 0
    splashMsg2Warn      db "WARNING: HIGH LEVELS", 0
    splashMsg3          db "> Pennywise AI...           ", 0
    splashMsg3Active    db "ACTIVE", 0
    splashMsg4          db "> Loading Render.asm...     ", 0
    splashMsg4OK        db "OK", 0
    
    splashLoadText      db "LOADING RESOURCES:", 0
    splashBarBracketL   db "[", 0
    splashBarBracketR   db "]", 0
    splashBarFill       db 219, 0  ; Single filled block character
    splashBarEmpty      db 176, 0  ; Single empty block character
    splashPercent       db "   0%", 0
    splashQuote         db '"They all float down here..."', 0
    
    ; Menu screen
    menuTitle       db "THE 8086 ARCHER", 0
    menuSubtitle    db "Balloon Shooting Game", 0
    menuOption1     db "[ START GAME ]", 0
    menuOption2     db "[ QUIT ]", 0
    menuFooter      db "[W/S]: Select   [ENTER]: Confirm   [ESC]: Exit", 0
    
    ; Game Over screen
    gameOverTitle   db "Y O U   D I E D", 0
    gameOverQuote   db "YOU'LL FLOAT TOO", 0
    gameOverScore   db "YOUR SCORE: ", 0
    gameOverRetry   db "R: Retry   Q: Quit to Menu", 0
    
    PUBLIC menuSelection
    menuSelection   DWORD 0     ; 0 = Start, 1 = Quit
    splashProgress  DWORD 0
    
    ; Theme colors (Retro Horror Red & Black)
    THEME_BORDER    equ 0Ch     ; Light Red on Black
    THEME_TEXT      equ 07h     ; Light Gray
    THEME_ACCENT    equ 0Eh     ; Yellow
    THEME_WARNING   equ 04h     ; Dark Red
    THEME_BTN_HOVER equ 4Fh     ; White on Red (inverted)
    
; ============================= CODE SECTION =================================
.code

; ----------------------------------------------------------------------------
; Procedure: CenterText
; Description: Calculate X position to center text
; Parameters: string pointer
; Returns: EAX = centered X position
; ----------------------------------------------------------------------------
CenterText PROC strPtr:DWORD
    push ebx
    invoke StrLen, strPtr
    
    mov ebx, SCREEN_WIDTH
    sub ebx, eax
    shr ebx, 1
    mov eax, ebx
    
    pop ebx
    ret
CenterText ENDP

; ----------------------------------------------------------------------------
; Procedure: DrawBorder
; Description: Draw a side border character at centered position
; Parameters: row number
; ----------------------------------------------------------------------------
DrawBorder PROC row:DWORD
    invoke DrawPixel, 1, row, 179, THEME_BORDER
    invoke DrawPixel, 78, row, 179, THEME_BORDER
    ret
DrawBorder ENDP

; ----------------------------------------------------------------------------
; Procedure: UpdateProgressBar
; Description: Draw progress bar with animation
; Parameters: percent (0-100), row number
; ----------------------------------------------------------------------------
UpdateProgressBar PROC uses ebx esi edi percent:DWORD, row:DWORD
    LOCAL i:DWORD
    LOCAL filled:DWORD
    LOCAL percentStr[8]:BYTE
    
    ; Draw bracket [
    invoke DrawPixel, 7, row, '[', THEME_BORDER
    
    ; Calculate filled blocks (46 chars max)
    mov eax, percent
    mov ebx, 46
    mul ebx
    mov ebx, 100
    xor edx, edx
    div ebx
    mov filled, eax
    
    ; Draw filled portion (red blocks)
    mov i, 0
FillLoop:
    mov eax, i
    cmp eax, filled
    jge EmptyStart
    
    mov ebx, i
    add ebx, 8
    invoke DrawPixel, ebx, row, 219, THEME_WARNING  ; Dark red fill
    
    inc i
    jmp FillLoop
    
EmptyStart:
    ; Draw empty portion (gray blocks)
EmptyLoop:
    mov eax, i
    cmp eax, 46
    jge BarDone
    
    mov ebx, i
    add ebx, 8
    invoke DrawPixel, ebx, row, 176, THEME_TEXT  ; Gray empty
    
    inc i
    jmp EmptyLoop
    
BarDone:
    ; Draw bracket ]
    invoke DrawPixel, 54, row, ']', THEME_BORDER
    
    ; Format percentage manually
    mov eax, percent
    xor edx, edx
    mov ebx, 100
    div ebx
    add al, '0'
    mov percentStr[0], al
    
    mov eax, percent
    xor edx, edx
    mov ebx, 10
    div ebx
    mov eax, edx
    add al, '0'
    mov percentStr[1], al
    
    mov eax, percent
    xor edx, edx
    mov ebx, 10
    div ebx
    add al, '0'
    mov percentStr[2], al
    
    mov byte ptr percentStr[3], '%'
    mov byte ptr percentStr[4], 0
    
    invoke WriteString, 56, row, ADDR percentStr, THEME_ACCENT
    
    ret
UpdateProgressBar ENDP

; ----------------------------------------------------------------------------
; Procedure: RenderSplashFrame
; Description: Render single frame of splash screen
; Parameters: progress percentage (0-100)
; ----------------------------------------------------------------------------
RenderSplashFrame PROC percent:DWORD
    LOCAL i:DWORD
    
    call ClearBuffer
    
    ; Draw top border (centered)
    invoke WriteString, 1, 1, ADDR splashBorder, THEME_BORDER
    
    ; Draw side borders for all rows
    mov i, 2
BorderLoop:
    cmp i, 23
    jge BorderDone
    invoke DrawBorder, i
    inc i
    jmp BorderLoop
BorderDone:
    
    ; Draw bottom border
    invoke WriteString, 1, 23, ADDR splashBorderBottom, THEME_BORDER
    
    ; Draw header line
    invoke WriteString, 4, 2, ADDR splashHeader, THEME_ACCENT
    invoke WriteString, 62, 2, ADDR splashSystem, THEME_ACCENT
    
    ; Draw welcome message
    invoke WriteString, 18, 5, ADDR splashWelcome, THEME_BORDER
    
    ; Draw protocol message
    invoke WriteString, 17, 7, ADDR splashProtocol, THEME_ACCENT
    
    ; Draw loading messages based on progress
    invoke WriteString, 6, 10, ADDR splashMsg1, THEME_TEXT
    mov eax, percent
    cmp eax, 25
    jl SkipMsg1
    invoke WriteString, 34, 10, ADDR splashMsg1OK, THEME_ACCENT
    
SkipMsg1:
    cmp eax, 25
    jl SkipMsg2Start
    invoke WriteString, 6, 11, ADDR splashMsg2, THEME_TEXT
    cmp eax, 50
    jl SkipMsg2Start
    invoke WriteString, 34, 11, ADDR splashMsg2Warn, THEME_WARNING
    
SkipMsg2Start:
    mov eax, percent
    cmp eax, 50
    jl SkipMsg3Start
    invoke WriteString, 6, 12, ADDR splashMsg3, THEME_TEXT
    cmp eax, 75
    jl SkipMsg3Start
    invoke WriteString, 34, 12, ADDR splashMsg3Active, THEME_WARNING
    
SkipMsg3Start:
    mov eax, percent
    cmp eax, 75
    jl SkipMsg4Start
    invoke WriteString, 6, 13, ADDR splashMsg4, THEME_TEXT
    cmp eax, 100
    jl SkipMsg4Start
    invoke WriteString, 34, 13, ADDR splashMsg4OK, THEME_ACCENT
    
SkipMsg4Start:
    ; Draw "LOADING RESOURCES:" text
    invoke WriteString, 6, 16, ADDR splashLoadText, THEME_TEXT
    
    ; Draw progress bar
    invoke UpdateProgressBar, percent, 18
    
    ; Draw horror quote at bottom
    invoke WriteString, 6, 21, ADDR splashQuote, THEME_BORDER
    
    ; Present the frame
    call PresentFrame
    
    ret
RenderSplashFrame ENDP

; ----------------------------------------------------------------------------
; Procedure: RenderSplash
; Description: Render animated splash/loading screen
; ----------------------------------------------------------------------------
RenderSplash PROC
    LOCAL progress:DWORD
    
    mov progress, 0
    
AnimationLoop:
    ; Render current frame
    invoke RenderSplashFrame, progress
    
    ; Delay for animation smoothness (30ms per frame)
    invoke Sleep, 30
    
    ; Increment progress (about 3.3% per frame for ~30 frames total)
    mov eax, progress
    add eax, 4
    mov progress, eax
    
    ; Check if done
    cmp progress, 100
    jle AnimationLoop
    
    ; Final frame at 100%
    invoke RenderSplashFrame, 100
    invoke Sleep, 500
    
    ret
RenderSplash ENDP

; ----------------------------------------------------------------------------
; Procedure: RenderMenu
; Description: Render main menu with horror theme
; ----------------------------------------------------------------------------
RenderMenu PROC
    LOCAL centerX:DWORD
    
    call ClearBuffer
    
    ; Render title
    invoke CenterText, ADDR menuTitle
    mov centerX, eax
    
    invoke WriteString, centerX, 8, ADDR menuTitle, THEME_BORDER
    
    ; Render subtitle
    invoke CenterText, ADDR menuSubtitle
    mov centerX, eax
    
    invoke WriteString, centerX, 10, ADDR menuSubtitle, THEME_TEXT
    
    ; Render option 1 (Start Game)
    invoke CenterText, ADDR menuOption1
    mov centerX, eax
    
    mov eax, menuSelection
    cmp eax, 0
    je HighlightOption1
    
    invoke WriteString, centerX, 14, ADDR menuOption1, THEME_ACCENT
    jmp DoOption2
    
HighlightOption1:
    invoke WriteString, centerX, 14, ADDR menuOption1, THEME_BTN_HOVER
    
DoOption2:
    ; Render option 2 (Quit)
    invoke CenterText, ADDR menuOption2
    mov centerX, eax
    
    mov eax, menuSelection
    cmp eax, 1
    je HighlightOption2
    
    invoke WriteString, centerX, 16, ADDR menuOption2, THEME_ACCENT
    jmp DoFooter
    
HighlightOption2:
    invoke WriteString, centerX, 16, ADDR menuOption2, THEME_BTN_HOVER
    
DoFooter:
    ; Render footer
    invoke CenterText, ADDR menuFooter
    mov centerX, eax
    
    invoke WriteString, centerX, 24, ADDR menuFooter, THEME_TEXT
    
    ; Present the frame
    call PresentFrame
    
    ret
RenderMenu ENDP

; ----------------------------------------------------------------------------
; Procedure: RenderGameOver
; Description: Render game over screen with horror theme
; ----------------------------------------------------------------------------
RenderGameOver PROC
    LOCAL centerX:DWORD
    
    call ClearBuffer
    
    ; Render "YOU DIED" title
    invoke CenterText, ADDR gameOverTitle
    mov centerX, eax
    
    invoke WriteString, centerX, 10, ADDR gameOverTitle, THEME_BTN_HOVER
    
    ; Render quote
    invoke CenterText, ADDR gameOverQuote
    mov centerX, eax
    
    invoke WriteString, centerX, 12, ADDR gameOverQuote, THEME_WARNING
    
    ; Render retry options
    invoke CenterText, ADDR gameOverRetry
    mov centerX, eax
    
    invoke WriteString, centerX, 24, ADDR gameOverRetry, THEME_TEXT
    
    ; Present the frame
    call PresentFrame
    
    ret
RenderGameOver ENDP

END
